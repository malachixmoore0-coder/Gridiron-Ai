{
  "expo": {
    "name": "Gridiron AI",
    "slug": "gridiron-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#05080C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gridironai.app"
    },
    "android": {
      "package": "com.gridironai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05080C"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "scheme": "gridironai"
  }
}