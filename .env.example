# Local development. Copy to .env — Expo reads it automatically.
#
# Both of these are public by design: the publishable key is compiled into the
# JavaScript bundle and every visitor to the site has it. What protects the data
# is row-level security in docs/social-schema.sql, not the secrecy of this key.
#
# The SERVICE ROLE / SECRET key (sb_secret_...) must NEVER appear in this file
# or anywhere else in this repo. It bypasses row-level security entirely. Its
# only home is the edge function's own secrets:
#   supabase secrets set STRIPE_SECRET_KEY=... SUPABASE_SERVICE_ROLE_KEY=...
EXPO_PUBLIC_SUPABASE_URL=https://ndacoxknypbkkhckztub.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xeEd1B1yNtIMuDeAL0ft9w_i34_sF6n

# Which social sign-ins are switched on in the Supabase dashboard. Unset means
# none, and the buttons are hidden rather than shown and broken — enabling a
# provider is a dashboard change, and this is the same change made twice on
# purpose so the button and the backend cannot disagree.
# EXPO_PUBLIC_OAUTH_PROVIDERS=google,apple

# Set to 1 only after adding {{ .Token }} to the Confirm signup and Magic Link
# templates — which Supabase only allows once custom SMTP is configured. It
# reveals the "type the code from the email" box, and until the template
# actually sends a code that box is a promise the email cannot keep.
# EXPO_PUBLIC_EMAIL_CODE=1

# Set once the entitlements function is deployed. Its presence is what makes the
# server, rather than the device, the authority on which tier somebody has.
# EXPO_PUBLIC_ENTITLEMENTS_URL=https://ndacoxknypbkkhckztub.functions.supabase.co/entitlements
